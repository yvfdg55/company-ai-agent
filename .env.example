# Core
DATABASE=company_agent.db
EXCEL_FILE=company.xlsx
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
MAX_HISTORY=12
MAX_DAILY_MESSAGES_PER_CUSTOMER=100
MAX_TOOL_STEPS=5

# Agent execution mode: local or external_api
CUSTOMER_AGENT_PROVIDER=local
MANAGEMENT_AGENT_PROVIDER=local
# OpenAI-compatible API settings (configure only for external_api mode)
CUSTOMER_AGENT_API_URL=
CUSTOMER_AGENT_API_KEY_ENV=CUSTOMER_AGENT_API_KEY
CUSTOMER_AGENT_API_MODEL=
CUSTOMER_AGENT_API_TIMEOUT=60
MANAGEMENT_AGENT_API_URL=
MANAGEMENT_AGENT_API_KEY_ENV=MANAGEMENT_AGENT_API_KEY
MANAGEMENT_AGENT_API_MODEL=
MANAGEMENT_AGENT_API_TIMEOUT=60

# WhatsApp Cloud API - fill only in your runtime environment
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WA_API_VERSION=v20.0
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=5000
# Optional defense-in-depth token for management routes/dispatch. Leave empty to disable.
MANAGEMENT_AUTH_TOKEN=
